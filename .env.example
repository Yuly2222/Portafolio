# Copia este archivo a .env.local para desarrollo local
# (.env.local no se sube a git). En Vercel, agrega estas mismas
# variables en Project Settings -> Environment Variables.
#
# Todas son opcionales: si no las defines, el sitio usa los valores
# por defecto de src/data/site.ts.

# URL pública del sitio ya desplegado (usada para SEO / Open Graph).
# Ejemplo en producción: https://tunombre.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email de contacto que se muestra en el sitio.
NEXT_PUBLIC_CONTACT_EMAIL=tu@email.com

# URL completa de tu perfil de Instagram.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/tuusuario

# Número de WhatsApp con código de país, solo dígitos (sin +, espacios ni guiones).
# Déjalo vacío para ocultar el enlace de WhatsApp.
NEXT_PUBLIC_WHATSAPP_NUMBER=
